# ==========================================
# Database Configuration (PostgreSQL)
# ==========================================
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=pos_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pos_db

# ==========================================
# Redis Cache & Message Broker
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==========================================
# Backend API Gateway (NestJS)
# ==========================================
PORT=4000
NODE_ENV=development
JWT_SECRET=super_secret_enterprise_pos_jwt_key_2026!
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=super_secret_refresh_key_2026!
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

# ==========================================
# AI/ML Forecasting Service (FastAPI)
# ==========================================
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_API_KEY=pos_internal_ml_service_key_2026

# ==========================================
# Frontend POS & Dashboard (Vite / React)
# ==========================================
VITE_API_BASE_URL=http://localhost:4000/api/v1
